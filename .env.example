# Server
PORT=3001
NODE_ENV=production

# Public URL of the deployed site. Comma-separate multiple origins.
# Same-origin requests are always allowed; set this if a client is served elsewhere.
CLIENT_ORIGIN=https://trail-signal.onrender.com

# Optional durable lobby storage. Without these, lobbies live in memory only.
# Use the Supabase project URL and the service_role key (never the anon key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map tiles are baked into the client at build time.
# For production traffic, use a provider such as MapTiler/Stadia and keep attribution.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
